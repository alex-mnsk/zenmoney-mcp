{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenmoney-mcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FINANCE",
        "class_name": "FinanceState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FinanceState"
      ]
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://your-worker.your-subdomain.workers.dev",
    "ENABLE_WRITES": "false"
  }
}
